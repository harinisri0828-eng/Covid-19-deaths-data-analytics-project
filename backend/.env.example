# Environment Configuration Example
# Replace with actual PostgreSQL connection URL in production or local setup
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/covid_db

# Server Configuration
HOST=127.0.0.1
PORT=8001
ENVIRONMENT=development

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000

# Dataset URLs
DATA_SOURCE_URL=https://covid.ourworldindata.org/data/owid-covid-data.csv
